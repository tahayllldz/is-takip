# Supabase bağlantısı (yerel: `pnpm db:status` çıktısından; bulut: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# YALNIZCA SUNUCU — asla NEXT_PUBLIC_ önekiyle yazmayın, istemciye gönderilmez.
# Davet ile yeni hesap açma (Auth Admin API) için gerekir.
SUPABASE_SECRET_KEY=

# Davet bağlantılarında kullanılan genel adres
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yeni şirket hesabı açılmasına izin ver (pilot döneminde kapatılabilir)
ALLOW_COMPANY_SIGNUP=true

# Push gönderici uç noktasını (/api/push/dispatch) koruyan uzun rastgele anahtar — YALNIZCA SUNUCU.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PUSH_DISPATCH_SECRET=
# İsteğe bağlı: Expo hesabında "Enhanced Security for Push Notifications" açıksa erişim anahtarı — YALNIZCA SUNUCU.
EXPO_ACCESS_TOKEN=
